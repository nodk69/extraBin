# Dependencies (rebuilt inside container via npm ci)
node_modules

# Build output (produced inside container via npm run build)
dist

# Version control
.git
.gitignore

# Test artifacts
coverage
playwright-report
test-results

# Environment files — NEVER leak host secrets into the image
.env
.env.local
.env.*.local
.env.example

# IDE / editor
.vscode
.idea
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Documentation source (not needed in runtime image, but docs/features/ is required for build)
# We keep docs/features/ for Vite ?raw imports, but exclude other markdown files
*.md
!docs/features/*.md
LICENSE

# CI configuration
.github

# Debug / log files
*.log
npm-debug.log*

# Qoder / agent artifacts
.qoder
