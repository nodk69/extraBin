# =====================================================================
# nginx edge configuration (P1-11 hardening)
#
# Included by nginx at HTTP context level (conf.d/*.conf), so http-stage
# directives such as limit_req_zone and map are declared here, before the
# server block.
# =====================================================================

# --- Rate limiting (P1-11: basic edge throttling before requests reach Spring) ---
# Per real edge peer. The backend remains the authority for application-level
# limits (login, register, reset, paste ops); this exists as defense in depth.
limit_req_zone $binary_remote_addr zone=api_zone:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=auth_zone:10m rate=3r/s;

# --- Conditional HSTS (P1-11) ---
# The container terminates plain HTTP; when a TLS terminator sits in front of it
# and forwards via X-Forwarded-Proto: https, HSTS is emitted. Over plain HTTP
# the variable is empty, meaning the header is NOT sent (correct per RFC 6797:
# HSTS must only be delivered over secure transport).
map $http_x_forwarded_proto $hsts_header {
    default "";
    https   "max-age=31536000; includeSubDomains";
}

server {
    listen 80;
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    client_max_body_size 2m;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml application/javascript application/json;

    # Security headers. NOTE nginx add_header semantics: these are re-declared
    # inside location blocks that define their own add_header (see /assets/),
    # because an add_header at any deeper level suppresses ALL inherited ones.
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Strict-Transport-Security $hsts_header always;
    # Mirrors the backend cascade CSP (single source of truth:
    # com.pastebin.config.SecurityConfig). Keep both in sync.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://storage.ko-fi.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://storage.ko-fi.com; img-src 'self' data: https://storage.ko-fi.com https://ko-fi.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://*.supabase.co https://ko-fi.com https://storage.ko-fi.com; frame-src 'self' https://ko-fi.com; frame-ancestors 'none'; form-action 'self' https://ko-fi.com; base-uri 'self'; object-src 'none';" always;

    # Static assets with long-term caching (P1-11: this location previously
    # defined Cache-Control alone, which dropped every inherited security header
    # for /assets/ responses).
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Strict-Transport-Security $hsts_header always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://storage.ko-fi.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://storage.ko-fi.com; img-src 'self' data: https://storage.ko-fi.com https://ko-fi.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://*.supabase.co https://ko-fi.com https://storage.ko-fi.com; frame-ancestors 'none'; form-action 'self' https://ko-fi.com; base-uri 'self'; object-src 'none';" always;
        # (kept as an explicit add_header rather than `expires 1y` to guarantee a
        # single, well-formed Cache-Control value)
    }

    # Reverse proxy for backend APIs
    location /api/ {
        limit_req zone=api_zone burst=30 nodelay;
        limit_req_status 429;

        proxy_pass ${BACKEND_URL}/api/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Correlation-ID $http_x_correlation_id;
        proxy_cache_bypass $http_upgrade;
        client_max_body_size 2m;
    }

    # P1-11: auth-sensitive endpoints get a stricter throttle than the general
    # API surface (credential stuffing sits on exactly these paths; the backend
    # rate limiter is the second layer behind this).
    location ^~ /api/v1/auth/ {
        limit_req zone=auth_zone burst=10 nodelay;
        limit_req_status 429;

        proxy_pass ${BACKEND_URL}/api/v1/auth/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 2m;
    }

    # Reverse proxy for public health probes only; block internal metrics and management endpoints
    location = /actuator/health {
        proxy_pass ${BACKEND_URL}/actuator/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # P0-04/P1-20: in prod the backend serves actuator on a dedicated management
    # port (8081) that nginx cannot route to; this 403 is defense in depth.
    location /actuator/ {
        return 403 "Forbidden";
    }

    # Dedicated Embed Route: allows external sites to frame snippets safely while preserving strict headers everywhere else
    location /embed/ {
        try_files $uri $uri/ /index.html;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Strict-Transport-Security $hsts_header always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://storage.ko-fi.com; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://*.supabase.co; frame-ancestors *; form-action 'none'; base-uri 'self'; object-src 'none';" always;
    }

    # Single Page Application routing fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
