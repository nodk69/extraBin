# Artillery environment template for the ExtraBin suite.
# Copy to .env and fill in. `.env` is gitignored - never commit real values.
#
# The SPA (https://frontend-jn3z.onrender.com) does NOT proxy /api/v1 - that
# path 404s at nginx. The browser talks to the API origin cross-origin, so the
# API base URL is the backend origin below.

# API origin + path prefix (where every scenario is sent)
API_URL=https://backend-umrd.onrender.com/api/v1

# Public website origin (SPA shell, used by the contract test)
FRONTEND_URL=https://frontend-jn3z.onrender.com

# public_id of an existing PUBLIC paste used as the read fixture.
# It must exist in the target database or reads return 404.
PASTE_ID=R7l0vHk6HT

# Artillery Cloud API key (starts with a9_). Used for `--record`.
# Leave empty to run purely locally.
ARTILLERY_CLOUD_API_KEY=
