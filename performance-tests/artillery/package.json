{
  "name": "extrabin-artillery-suite",
  "version": "1.0.0",
  "private": true,
  "description": "Artillery load and abuse test suite for the ExtraBin PasteBin API",
  "scripts": {
    "contract": "artillery run --env-file .env tests/contract.yml",
    "smoke": "artillery run --env-file .env tests/smoke.yml",
    "baseline": "artillery run --env-file .env tests/baseline.yml",
    "load": "artillery run --env-file .env tests/load.yml",
    "abuse:password-reset": "artillery run --env-file .env tests/abuse-password-reset.yml",
    "abuse:password-reset-request": "artillery run --env-file .env tests/abuse-password-reset-request.yml",
    "abuse:discovery": "artillery run --env-file .env tests/abuse-discovery-scrape.yml",
    "abuse:view-count": "artillery run --env-file .env tests/abuse-view-inflation.yml",
    "abuse:vote": "artillery run --env-file .env tests/abuse-vote-inflation.yml"
  },
  "devDependencies": {
    "artillery": "^2.0.0"
  }
}
