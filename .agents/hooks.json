{
  "command-safety-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/hooks/pre-tool-use.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "change-tracker": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/hooks/post-tool-use.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "verification-reminder": {
    "Stop": [
      {
        "type": "command",
        "command": "node .agents/hooks/stop-verification.mjs",
        "timeout": 10
      }
    ]
  }
}
