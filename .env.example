# -------------------------------------------------------------
# PasteBin Environment Configuration Template (.env.example)
# Copy this file to .env and configure values for your environment.
# NEVER commit real production secrets to source control.
# -------------------------------------------------------------

# Backend Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Supabase (REQUIRED for registration/OAuth flows)
# SUPABASE_URL / SUPABASE_ANON_KEY: server-side use of the Supabase REST API.
# SUPABASE_SERVICE_ROLE_KEY: SERVER ONLY - bypasses all Row Level Security. Never expose to the frontend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL Database
DATABASE_URL=jdbc:postgresql://localhost:5432/pastebin
DATABASE_USERNAME=pastebin
DATABASE_PASSWORD=pastebin_secure_password_placeholder

# Security & CORS
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_SESSION_SECURE_COOKIE=false

# Operational Limits
APP_MAX_PASTE_BYTES=1048576
APP_CLEANUP_CRON=0 */5 * * * *

# Error Tracking (Sentry) — Leave empty in development to disable
SENTRY_DSN=
VITE_SENTRY_DSN=

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
